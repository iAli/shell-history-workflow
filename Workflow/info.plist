				<string>import json
import os
import sys

shell = os.environ.get("selected_shell", "zsh")

history_files = {
    "zsh": "~/.zsh_history",
    "bash": "~/.bash_history",
}

history_file = os.path.expanduser(history_files[shell])

try:
    with open(history_file, "r", encoding="utf-8", errors="replace") as f:
        commands = f.read().splitlines()
except OSError as e:
    print(json.dumps({
        "items": [{
            "title": "Cannot read history file",
            "subtitle": str(e),
            "valid": False
        }]
    }))
    sys.exit(0)

items = []

for command in reversed(commands):
    if not command.strip():
        continue

    items.append({
        "title": command,
        "arg": command,
    })

print(json.dumps({"items": items}, ensure_ascii=False))</string>
